# Entorno
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Supabase Postgres
# DATABASE_URL: Transaction Mode / PgBouncer (puerto 6543) -> aplicación Express
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL: Session Mode / conexión directa (puerto 5432) -> Prisma CLI
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Auth local (bcrypt + JWT propio)
# Secreto de al menos 32 caracteres usado para firmar los access token HS256.
# Generarlo con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_JWT_SECRET=<secreto-de-al-menos-32-caracteres>

# Emisor del token (issuer). Debe coincidir con el que valida el middleware.
AUTH_JWT_ISSUER=savemoney

# TTL en segundos del access token (default 900 = 15 min).
AUTH_ACCESS_TOKEN_TTL=900

# TTL en segundos del refresh token (default 604800 = 7 días).
AUTH_REFRESH_TOKEN_TTL=604800

# Supabase Auth (legado, ya no se usa para validar tokens; se conserva por compatibilidad)
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
