# Entorno
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Supabase Postgres
# DATABASE_URL: Transaction Mode / PgBouncer (puerto 6543) -> aplicación Express
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL: Session Mode / conexión directa (puerto 5432) -> Prisma CLI
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Supabase Auth
SUPABASE_URL=https://<project-ref>.supabase.co

# Opción A (recomendada, claves asimétricas): URL explícita del JWKS.
# Si se omite, se deriva de SUPABASE_URL + /auth/v1/.well-known/jwks.json.
# SUPABASE_JWKS_URL=

# Opción B (compatibilidad, JWT secret HS256 legacy).
# SUPABASE_JWT_SECRET=
