model alerta {
  id_alerta             BigInt                 @id @default(autoincrement())
  id_usuario            BigInt
  id_tipo_alerta        Int                    @db.SmallInt
  id_presupuesto        BigInt?
  id_limite             BigInt?
  id_meta               BigInt?
  id_compra_impulsiva   BigInt?
  mensaje               String                 @db.VarChar(300)
  fecha_generacion      DateTime               @db.Timestamp(6)
  fecha_lectura         DateTime?              @db.Timestamp(6)
  compra_impulsiva      compra_impulsiva?      @relation(fields: [id_compra_impulsiva], references: [id_compra_impulsiva], onDelete: NoAction, onUpdate: NoAction)
  presupuesto_categoria presupuesto_categoria? @relation(fields: [id_limite], references: [id_limite], onDelete: NoAction, onUpdate: NoAction)
  meta_ahorro           meta_ahorro?           @relation(fields: [id_meta], references: [id_meta], onDelete: NoAction, onUpdate: NoAction)
  presupuesto           presupuesto?           @relation(fields: [id_presupuesto], references: [id_presupuesto], onDelete: NoAction, onUpdate: NoAction)
  tipo_alerta           tipo_alerta            @relation(fields: [id_tipo_alerta], references: [id_tipo_alerta], onDelete: NoAction, onUpdate: NoAction)
  usuario               usuario                @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)

  @@index([id_compra_impulsiva], map: "idx_alerta_compra_impulsiva")
  @@index([id_limite], map: "idx_alerta_limite")
  @@index([id_meta], map: "idx_alerta_meta")
  @@index([id_presupuesto], map: "idx_alerta_presupuesto")
  @@index([id_usuario], map: "idx_alerta_usuario")
}

